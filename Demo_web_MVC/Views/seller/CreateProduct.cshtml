@model Demo_web_MVC.Models.ViewModel.Product.ProductViewModel

@{
    ViewData["Title"] = "Thêm sản phẩm";
}

<!DOCTYPE html>
<html class="light" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Thêm sản phẩm | AdminPanel</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "surface-dim": "#d6dae0",
                        "on-primary": "#ffffff",
                        "surface-bright": "#f5faff",
                        "primary-container": "#00aeef",
                        "surface-container-highest": "#dee3e8",
                        "error": "#ba1a1a",
                        "outline": "#6e7881",
                        "inverse-surface": "#2c3135",
                        "on-background": "#171c20",
                        "background": "#f5faff",
                        "surface-container": "#eaeef4",
                        "primary": "#00658d",
                        "on-surface": "#171c20",
                        "secondary": "#5d5f5f",
                        "surface": "#f5faff",
                        "outline-variant": "#bdc8d1",
                        "error-container": "#ffdad6",
                        "surface-container-low": "#eff4fa",
                        "surface-container-lowest": "#ffffff",
                        "surface-container-high": "#e4e9ee",
                        "on-surface-variant": "#3e4850",
                        "on-primary-container": "#003e58"
                    },
                    borderRadius: {
                        DEFAULT: "0.25rem",
                        lg: "0.5rem",
                        xl: "0.75rem",
                        full: "9999px"
                    },
                    spacing: {
                        xs: "4px",
                        sm: "8px",
                        md: "16px",
                        lg: "24px",
                        xl: "48px"
                    },
                    fontFamily: {
                        "label-bold": ["Be Vietnam Pro"],
                        "headline-md": ["Be Vietnam Pro"],
                        "display-lg": ["Be Vietnam Pro"],
                        "body-base": ["Be Vietnam Pro"],
                        "body-sm": ["Be Vietnam Pro"]
                    },
                    fontSize: {
                        "label-bold": ["12px", { lineHeight: "1.2", letterSpacing: "0.02em", fontWeight: "700" }],
                        "body-sm": ["14px", { lineHeight: "1.5", fontWeight: "400" }],
                        "headline-md": ["20px", { lineHeight: "1.4", fontWeight: "600" }],
                        "display-lg": ["32px", { lineHeight: "1.2", fontWeight: "700" }],
                        "body-base": ["16px", { lineHeight: "1.5", fontWeight: "400" }]
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Be Vietnam Pro', sans-serif;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .variant-row:hover .variant-actions {
            opacity: 1;
        }

        .variant-actions {
            opacity: 0;
            transition: opacity 0.2s;
        }
    </style>
</head>

<body class="bg-background text-on-surface">

    <div class="flex min-h-screen">
        <!-- SideNavBar -->
        <nav class="fixed left-0 top-0 h-screen flex flex-col pt-lg pb-md w-64 z-40 bg-surface-container-lowest border-r border-outline-variant">
            <div class="px-lg mb-xl flex items-center gap-md">
                <div class="w-10 h-10 bg-primary-container rounded-lg flex items-center justify-center">
                    <span class="material-symbols-outlined text-white">shopping_bag</span>
                </div>

                <div>
                    <h2 class="font-headline-md text-headline-md text-primary-container">ShopCentral</h2>
                    <p class="text-[10px] text-on-surface-variant font-medium tracking-wider uppercase">
                        Management Hub
                    </p>
                </div>
            </div>

            <div class="flex-1 px-md space-y-xs">
                <a asp-action="Dashboard" asp-controller="Seller" class="flex items-center gap-md px-md py-sm text-on-surface-variant hover:bg-surface-container-high transition-all duration-200 rounded-lg group">
                    <span class="material-symbols-outlined group-hover:text-primary">dashboard</span>
                    <span class="font-label-bold text-label-bold">Bảng điều khiển</span>
                </a>

                <a asp-action="ProductsManager" asp-controller="Seller" class="flex items-center gap-md px-md py-sm bg-primary-container/10 text-primary border-r-4 border-primary rounded-lg translate-x-1 transition-transform">
                    <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' ;">shopping_bag</span>
                    <span class="font-label-bold text-label-bold">Sản phẩm</span>
                </a>
                <a asp-action="Statistics" asp-controller="Seller" class="flex items-center gap-md p-md rounded-xl text-on-surface-variant dark:text-outline font-body-base hover:bg-surface-container-high dark:hover:bg-surface-container-highest transition-colors duration-200">
                    <span class="material-symbols-outlined">query_stats</span>
                    <span class="font-body-base">Thống kê</span>
                </a>
               
            </div>

            <div class="px-md pt-md border-t border-outline-variant">
                <a asp-action="Logout" asp-controller="User" class="flex items-center gap-md px-md py-sm text-error hover:bg-error-container/10 transition-all duration-200 rounded-lg" >
                    <span class="material-symbols-outlined">logout</span>
                    <span class="font-label-bold text-label-bold">Đăng xuất</span>
                </a>
            </div>
        </nav>

        <!-- Main Content -->
        <main class="ml-64 w-full p-lg">
            <form asp-action="CreateProduct" asp-controller="Seller" enctype="multipart/form-data" method="post">

                <div class="flex justify-between items-end mb-lg">
                    <div>
                        <nav class="flex gap-xs text-[12px] text-on-surface-variant mb-xs">
                            <span>Sản phẩm</span>
                            <span>/</span>
                            <span class="text-primary font-semibold">Thêm mới</span>
                        </nav>

                        <h1 class="font-display-lg text-display-lg text-on-surface">
                            Thêm sản phẩm
                        </h1>
                    </div>

                    <div class="flex gap-md">
                        <a asp-action="ProductsManager"
                           asp-controller="Seller"
                           class="px-lg py-sm border border-primary text-primary rounded-lg font-label-bold text-label-bold hover:bg-primary-container/5 transition-colors">
                            Hủy bỏ
                        </a>

                        <button class="px-lg py-sm bg-primary-container text-white rounded-lg font-label-bold text-label-bold shadow-md hover:shadow-lg hover:bg-primary transition-all flex items-center gap-sm"
                                type="submit">
                            <span class="material-symbols-outlined text-[18px]">save</span>
                            Lưu sản phẩm
                        </button>
                    </div>
                </div>

                <div asp-validation-summary="All" class="text-error text-sm mb-md"></div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-lg">
                    <!-- Left Column -->
                    <div class="lg:col-span-2 space-y-lg">

                        <!-- Product Information -->
                        <section class="bg-surface-container-lowest rounded-lg p-lg shadow-[0px_4px_12px_rgba(0,0,0,0.05)] border border-outline-variant/30">
                            <h2 class="font-headline-md text-headline-md mb-lg flex items-center gap-sm text-primary">
                                <span class="material-symbols-outlined">info</span>
                                Thông tin chung
                            </h2>

                            <div class="space-y-md">
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-md">
                                    <div class="space-y-xs">
                                        <label asp-for="Name" class="font-label-bold text-label-bold text-on-surface-variant">
                                            Tên sản phẩm *
                                        </label>

                                        <input asp-for="Name"
                                               class="w-full px-md py-sm rounded-lg border border-outline-variant focus:ring-2 focus:ring-primary-container focus:border-primary-container transition-all text-body-base outline-none"
                                               placeholder="Ví dụ: Áo thun Cotton Premium" />

                                        <span asp-validation-for="Name" class="text-error text-[12px]"></span>
                                    </div>

                                    <div class="space-y-xs">
                                        <label asp-for="Brand" class="font-label-bold text-label-bold text-on-surface-variant">
                                            Thương hiệu
                                        </label>

                                        <input asp-for="Brand"
                                               class="w-full px-md py-sm rounded-lg border border-outline-variant focus:ring-2 focus:ring-primary-container focus:border-primary-container transition-all text-body-base outline-none"
                                               placeholder="Ví dụ: Nike, Adidas..." />

                                        <span asp-validation-for="Brand" class="text-error text-[12px]"></span>
                                    </div>
                                </div>

                                <div class="space-y-xs">
                                    <label asp-for="CategoryId" class="font-label-bold text-label-bold text-on-surface-variant">
                                        Danh mục
                                    </label>

                                    <select asp-for="CategoryId"
                                            class="w-full px-md py-sm rounded-lg border border-outline-variant focus:ring-2 focus:ring-primary-container focus:border-primary-container transition-all text-body-base outline-none">
                                        <option value="">-- Chọn danh mục --</option>

                                        @if (Model.Categories != null)
                                        {
                                            foreach (var category in Model.Categories)
                                            {
                                                <option value="@category.Id">@category.Name</option>
                                            }
                                        }
                                    </select>

                                    <span asp-validation-for="CategoryId" class="text-error text-[12px]"></span>
                                </div>

                                <div class="space-y-xs">
                                    <label asp-for="Description" class="font-label-bold text-label-bold text-on-surface-variant">
                                        Mô tả sản phẩm
                                    </label>

                                    <div class="border border-outline-variant rounded-lg overflow-hidden">
                                        <div class="bg-surface-container-low border-b border-outline-variant p-xs flex gap-xs">
                                            <button class="p-xs hover:bg-surface-container-high rounded text-on-surface-variant" type="button">
                                                <span class="material-symbols-outlined text-[20px]">format_bold</span>
                                            </button>

                                            <button class="p-xs hover:bg-surface-container-high rounded text-on-surface-variant" type="button">
                                                <span class="material-symbols-outlined text-[20px]">format_italic</span>
                                            </button>

                                            <button class="p-xs hover:bg-surface-container-high rounded text-on-surface-variant" type="button">
                                                <span class="material-symbols-outlined text-[20px]">format_list_bulleted</span>
                                            </button>
                                        </div>

                                        <textarea asp-for="Description"
                                                  class="w-full p-md text-body-base outline-none resize-none"
                                                  placeholder="Nhập mô tả chi tiết cho sản phẩm..."
                                                  rows="6"></textarea>
                                    </div>

                                    <span asp-validation-for="Description" class="text-error text-[12px]"></span>
                                </div>
                            </div>
                        </section>

                        <!-- Product Images -->
                        <section class="bg-surface-container-lowest rounded-lg p-lg shadow-[0px_4px_12px_rgba(0,0,0,0.05)] border border-outline-variant/30">
                            <div class="flex justify-between items-center mb-lg">
                                <h2 class="font-headline-md text-headline-md flex items-center gap-sm text-primary">
                                    <span class="material-symbols-outlined">image</span>
                                    Hình ảnh sản phẩm
                                </h2>

                                <span class="text-body-sm text-on-surface-variant">
                                    Có thể chọn nhiều ảnh JPG, PNG.
                                </span>
                            </div>

                            <div class="grid grid-cols-2 md:grid-cols-4 gap-md" id="product-preview-wrapper">
                                <div class="group relative aspect-square bg-surface-container rounded-lg border border-outline-variant overflow-hidden">
                                    <img id="preview-image"
                                         alt="Product Preview"
                                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                         src="/uploads/images/vidu.jpg" />

                                    <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col justify-between p-xs">
                                        <div class="flex justify-end">
                                            <button class="w-8 h-8 bg-error text-white rounded-full flex items-center justify-center hover:scale-110 transition-transform"
                                                    type="button">
                                                <span class="material-symbols-outlined text-[18px]">delete</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <label class="cursor-pointer aspect-square bg-surface-container-low border-2 border-dashed border-outline-variant rounded-lg flex flex-col items-center justify-center gap-xs hover:bg-surface-container-high hover:border-primary-container transition-all group">
                                    <input name="imageUrl"
                                           class="hidden"
                                           multiple
                                           type="file"
                                           id="image-upload"
                                           onchange="previewProductImage(event)" />

                                    <span class="material-symbols-outlined text-[32px] text-on-surface-variant group-hover:text-primary-container">
                                        cloud_upload
                                    </span>

                                    <span class="font-label-bold text-label-bold text-on-surface-variant group-hover:text-primary-container">
                                        Tải ảnh lên
                                    </span>
                                </label>
                            </div>

                            <span asp-validation-for="imageUrl" class="text-error text-[12px]"></span>
                        </section>

                        <!-- Variants -->
                        <section class="bg-surface-container-lowest rounded-lg p-lg shadow-[0px_4px_12px_rgba(0,0,0,0.05)] border border-outline-variant/30">
                            <div class="flex justify-between items-center mb-lg">
                                <h2 class="font-headline-md text-headline-md flex items-center gap-sm text-primary">
                                    <span class="material-symbols-outlined">layers</span>
                                    Biến thể &amp; Giá bán
                                </h2>

                                <button class="flex items-center gap-sm text-primary font-label-bold text-label-bold hover:underline"
                                        type="button"
                                        id="addVariantButton">
                                    <span class="material-symbols-outlined text-[18px]">add_circle</span>
                                    Thêm biến thể
                                </button>
                            </div>

                            <div class="overflow-x-auto">
                                <table class="w-full text-left">
                                    <thead>
                                        <tr class="border-b border-outline-variant text-on-surface-variant">
                                            <th class="pb-sm font-label-bold text-label-bold uppercase">Ảnh</th>
                                            <th class="pb-sm font-label-bold text-label-bold uppercase">Biến thể</th>
                                            <th class="pb-sm font-label-bold text-label-bold uppercase">Giá bán (₫)</th>
                                            <th class="pb-sm font-label-bold text-label-bold uppercase">Kho hàng</th>
                                            <th class="pb-sm text-right font-label-bold text-label-bold uppercase">Hành động</th>
                                        </tr>
                                    </thead>

                                    <tbody id="variants-body" class="divide-y divide-outline-variant/50">
                                        <tr class="variant-row group">
                                            <td class="py-md">
                                                <label class="cursor-pointer block">
                                                    <input name="Variants[0].ImageFiles"
                                                           type="file"
                                                           class="hidden variant-image-input"
                                                           multiple
                                                           onchange="previewVariantImage(this)" />

                                                    <div class="w-14 h-14 bg-surface-container rounded-lg flex items-center justify-center border border-outline-variant relative overflow-hidden group-hover:border-primary-container">
                                                        <img class="variant-preview hidden w-full h-full object-cover" src="" alt="Variant Preview" />
                                                        <span class="material-symbols-outlined text-outline text-[22px] variant-icon">
                                                            add_a_photo
                                                        </span>
                                                    </div>
                                                </label>
                                            </td>

                                            <td class="py-md">
                                                <div class="space-y-xs">
                                                    <input name="Variants[0].Size"
                                                           class="w-32 px-sm py-xs border border-outline-variant rounded bg-transparent focus:ring-1 focus:ring-primary-container outline-none text-body-sm"
                                                           placeholder="Size" />

                                                    <input name="Variants[0].Color"
                                                           class="w-32 px-sm py-xs border border-outline-variant rounded bg-transparent focus:ring-1 focus:ring-primary-container outline-none text-body-sm"
                                                           placeholder="Màu sắc" />
                                                </div>
                                            </td>

                                            <td class="py-md">
                                                <input name="Variants[0].Price"
                                                       class="w-32 px-sm py-xs border border-outline-variant rounded bg-transparent focus:ring-1 focus:ring-primary-container outline-none font-label-bold"
                                                       type="number"
                                                       step="1000"
                                                       placeholder="Giá" />
                                            </td>

                                            <td class="py-md">
                                                <input name="Variants[0].Stock"
                                                       class="w-24 px-sm py-xs border border-outline-variant rounded bg-transparent focus:ring-1 focus:ring-primary-container outline-none"
                                                       type="number"
                                                       placeholder="Kho" />
                                            </td>

                                            <td class="py-md text-right">
                                                <div class="variant-actions flex justify-end gap-sm">
                                                    <button class="p-xs text-on-surface-variant hover:text-primary transition-colors"
                                                            title="Thêm ảnh biến thể"
                                                            type="button"
                                                            onclick="openVariantFile(this)">
                                                        <span class="material-symbols-outlined text-[20px]">imagesmode</span>
                                                    </button>

                                                    <button class="p-xs text-on-surface-variant hover:text-error transition-colors remove-variant"
                                                            title="Xóa"
                                                            type="button">
                                                        <span class="material-symbols-outlined text-[20px]">delete</span>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </section>
                    </div>

                    <!-- Right Column -->
                    <div class="space-y-lg">
                        <section class="bg-primary/5 rounded-lg p-lg border border-primary/20">
                            <h3 class="font-label-bold text-label-bold text-primary flex items-center gap-sm mb-xs">
                                <span class="material-symbols-outlined text-[18px]">lightbulb</span>
                                Mẹo quản lý
                            </h3>

                            <p class="text-body-sm text-on-primary-container leading-relaxed">
                                Bước 1: Ở ô Tên sản phẩm, nhập tên sản phẩm cần bán, ví dụ: Áo thun nam Cotton.<br />
                                Bước 2: Ở ô Thương hiệu, nhập tên thương hiệu của sản phẩm, ví dụ: Nike, Adidas hoặc Local Brand.<br />
                                Bước 3: Ở ô Danh mục, chọn nhóm sản phẩm phù hợp, ví dụ: Áo, Quần, Giày hoặc Phụ kiện.<br />
                                Bước 4: Ở ô Mô tả sản phẩm, nhập thông tin chi tiết như chất liệu, kiểu dáng, công dụng và điểm nổi bật của sản phẩm.<br />
                                Bước 5: Ở phần Hình ảnh sản phẩm, bấm Tải ảnh lên và chọn một hoặc nhiều ảnh đại diện cho sản phẩm.<br />
                                Bước 6: Ở phần Biến thể, nhập Size của sản phẩm, ví dụ: S, M, L, XL.<br />
                                Bước 7: Nhập Màu sắc của biến thể, ví dụ: Đen, Trắng, Xanh hoặc Đỏ.<br />
                                Bước 8: Nhập Giá bán cho từng biến thể, ví dụ: 150000.<br />
                                Bước 9: Nhập Số lượng tồn kho cho từng biến thể, ví dụ: 20.<br />
                                Bước 10: Tải ảnh riêng cho biến thể nếu sản phẩm có nhiều màu hoặc nhiều mẫu khác nhau.<br />
                                Bước 11: Nếu có nhiều biến thể, bấm Thêm biến thể để nhập thêm size, màu, giá và số lượng khác.<br />
                                Bước 12: Sau khi nhập xong toàn bộ thông tin, bấm Lưu sản phẩm để thêm sản phẩm vào hệ thống.
                            </p>
                        </section>
                    </div>
                </div>
            </form>
        </main>
    </div>

    <!-- Mobile Footer -->
    <div class="md:hidden fixed bottom-0 left-0 right-0 p-md bg-surface-container-lowest border-t border-outline-variant flex gap-md z-50">
        <button class="flex-1 py-sm border border-primary text-primary rounded-lg font-label-bold text-label-bold" type="button">
            Hủy
        </button>

        <button class="flex-1 py-sm bg-primary-container text-white rounded-lg font-label-bold text-label-bold" type="submit">
            Lưu lại
        </button>
    </div>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }

    <script>
        let variantIndex = 1;

        function previewProductImage(event) {
            const file = event.target.files[0];

            if (!file) return;

            const reader = new FileReader();

            reader.onload = function (e) {
                document.getElementById("preview-image").src = e.target.result;
            };

            reader.readAsDataURL(file);
        }

        function previewVariantImage(input) {
            const file = input.files[0];

            if (!file) return;

            const row = input.closest(".variant-row");
            const preview = row.querySelector(".variant-preview");
            const icon = row.querySelector(".variant-icon");

            const reader = new FileReader();

            reader.onload = function (e) {
                preview.src = e.target.result;
                preview.classList.remove("hidden");
                icon.classList.add("hidden");
            };

            reader.readAsDataURL(file);
        }

        function openVariantFile(button) {
            const row = button.closest(".variant-row");
            const input = row.querySelector(".variant-image-input");

            input.click();
        }

        document.getElementById("addVariantButton").addEventListener("click", function () {
            const tbody = document.getElementById("variants-body");

            const html = `
                <tr class="variant-row group">
                    <td class="py-md">
                        <label class="cursor-pointer block">
                            <input name="Variants[${variantIndex}].ImageFiles"
                                   type="file"
                                   class="hidden variant-image-input"
                                   multiple
                                   onchange="previewVariantImage(this)" />

                            <div class="w-14 h-14 bg-surface-container rounded-lg flex items-center justify-center border border-outline-variant relative overflow-hidden group-hover:border-primary-container">
                                <img class="variant-preview hidden w-full h-full object-cover" src="" alt="Variant Preview" />
                                <span class="material-symbols-outlined text-outline text-[22px] variant-icon">
                                    add_a_photo
                                </span>
                            </div>
                        </label>
                    </td>

                    <td class="py-md">
                        <div class="space-y-xs">
                            <input name="Variants[${variantIndex}].Size"
                                   class="w-32 px-sm py-xs border border-outline-variant rounded bg-transparent focus:ring-1 focus:ring-primary-container outline-none text-body-sm"
                                   placeholder="Size" />

                            <input name="Variants[${variantIndex}].Color"
                                   class="w-32 px-sm py-xs border border-outline-variant rounded bg-transparent focus:ring-1 focus:ring-primary-container outline-none text-body-sm"
                                   placeholder="Màu sắc" />
                        </div>
                    </td>

                    <td class="py-md">
                        <input name="Variants[${variantIndex}].Price"
                               class="w-32 px-sm py-xs border border-outline-variant rounded bg-transparent focus:ring-1 focus:ring-primary-container outline-none font-label-bold"
                               type="number"
                               step="1000"
                               placeholder="Giá" />
                    </td>

                    <td class="py-md">
                        <input name="Variants[${variantIndex}].Stock"
                               class="w-24 px-sm py-xs border border-outline-variant rounded bg-transparent focus:ring-1 focus:ring-primary-container outline-none"
                               type="number"
                               placeholder="Kho" />
                    </td>

                    <td class="py-md text-right">
                        <div class="variant-actions flex justify-end gap-sm">
                            <button class="p-xs text-on-surface-variant hover:text-primary transition-colors"
                                    title="Thêm ảnh biến thể"
                                    type="button"
                                    onclick="openVariantFile(this)">
                                <span class="material-symbols-outlined text-[20px]">imagesmode</span>
                            </button>

                            <button class="p-xs text-on-surface-variant hover:text-error transition-colors remove-variant"
                                    title="Xóa"
                                    type="button">
                                <span class="material-symbols-outlined text-[20px]">delete</span>
                            </button>
                        </div>
                    </td>
                </tr>
            `;

            tbody.insertAdjacentHTML("beforeend", html);
            variantIndex++;
        });

        document.addEventListener("click", function (e) {
            const removeButton = e.target.closest(".remove-variant");

            if (!removeButton) return;

            const rows = document.querySelectorAll(".variant-row");

            if (rows.length <= 1) {
                alert("Phải có ít nhất 1 biến thể sản phẩm.");
                return;
            }

            removeButton.closest(".variant-row").remove();
        });
    </script>
</body>
</html>
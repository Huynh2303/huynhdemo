<!DOCTYPE html>

<html class="light" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;600;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface-dim": "#d6dae0",
                        "on-tertiary": "#ffffff",
                        "surface-container-lowest": "#ffffff",
                        "secondary": "#5d5f5f",
                        "surface-container-high": "#e4e9ee",
                        "on-secondary-container": "#616363",
                        "tertiary": "#8d4f00",
                        "secondary-fixed-dim": "#c6c6c7",
                        "tertiary-fixed": "#ffdcc0",
                        "surface-variant": "#dee3e8",
                        "on-primary": "#ffffff",
                        "outline": "#6e7881",
                        "surface-container-low": "#eff4fa",
                        "surface-container": "#eaeef4",
                        "background": "#f5faff",
                        "primary-fixed": "#c6e7ff",
                        "surface-bright": "#f5faff",
                        "on-secondary-fixed": "#1a1c1c",
                        "surface-tint": "#00658d",
                        "tertiary-fixed-dim": "#ffb876",
                        "secondary-container": "#dfe0e0",
                        "on-error-container": "#93000a",
                        "outline-variant": "#bdc8d1",
                        "inverse-surface": "#2c3135",
                        "inverse-on-surface": "#ecf1f7",
                        "on-tertiary-fixed": "#2d1600",
                        "on-secondary": "#ffffff",
                        "error-container": "#ffdad6",
                        "primary-fixed-dim": "#82cfff",
                        "on-tertiary-fixed-variant": "#6b3b00",
                        "tertiary-container": "#ea8c21",
                        "on-primary-container": "#003e58",
                        "on-error": "#ffffff",
                        "primary-container": "#00aeef",
                        "inverse-primary": "#82cfff",
                        "on-secondary-fixed-variant": "#454747",
                        "on-primary-fixed": "#001e2d",
                        "error": "#ba1a1a",
                        "primary": "#00658d",
                        "on-tertiary-container": "#572f00",
                        "surface-container-highest": "#dee3e8",
                        "on-surface": "#171c20",
                        "on-surface-variant": "#3e4850",
                        "surface": "#f5faff",
                        "secondary-fixed": "#e2e2e2",
                        "on-primary-fixed-variant": "#004c6b",
                        "on-background": "#171c20"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "md": "16px",
                        "container-max": "1200px",
                        "unit": "4px",
                        "xl": "48px",
                        "lg": "24px",
                        "xs": "4px",
                        "gutter": "16px",
                        "sm": "8px"
                    },
                    "fontFamily": {
                        "headline-md": ["Be Vietnam Pro"],
                        "body-sm": ["Be Vietnam Pro"],
                        "label-bold": ["Be Vietnam Pro"],
                        "display-lg": ["Be Vietnam Pro"],
                        "body-base": ["Be Vietnam Pro"],
                        "price-lg": ["Be Vietnam Pro"]
                    },
                    "fontSize": {
                        "headline-md": ["20px", {"lineHeight": "1.4", "fontWeight": "600"}],
                        "body-sm": ["14px", {"lineHeight": "1.5", "fontWeight": "400"}],
                        "label-bold": ["12px", {"lineHeight": "1.2", "letterSpacing": "0.02em", "fontWeight": "700"}],
                        "display-lg": ["32px", {"lineHeight": "1.2", "fontWeight": "700"}],
                        "body-base": ["16px", {"lineHeight": "1.5", "fontWeight": "400"}],
                        "price-lg": ["24px", {"lineHeight": "1", "fontWeight": "700"}]
                    }
                },
            },
        }
    </script>
    <style>
        body {
            font-family: 'Be Vietnam Pro', sans-serif;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .custom-shadow {
            box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.05);
        }

        .active-shadow {
            box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.1);
        }

        input:focus, select:focus, textarea:focus {
            border-color: #00AEEF !important;
            outline: none;
            ring: 0;
        }
    </style>
</head>
<body class="bg-background text-on-surface">
    <!-- SideNavBar Anchor -->
    <aside class="fixed left-0 top-0 h-screen w-64 bg-surface dark:bg-surface-container shadow-[0px_4px_12px_rgba(0,0,0,0.05)] flex flex-col py-lg px-md z-40">
        <div class="mb-xl px-sm">
            <span class="font-headline-md text-headline-md font-bold text-primary dark:text-primary-fixed-dim">Seller Pro</span>
            <p class="text-on-surface-variant font-body-sm text-body-sm">Vibrant blue dashboard</p>
        </div>
        <nav class="flex-grow space-y-unit">
            <a class="flex items-center gap-md p-md rounded-lg text-on-surface-variant dark:text-outline font-body-base hover:bg-surface-container-high transition-colors duration-200" href="#">
                <span class="material-symbols-outlined">dashboard</span> Dashboard
            </a>
            <a class="flex items-center gap-md p-md rounded-lg text-primary-container dark:text-primary-fixed-dim font-bold border-r-4 border-primary-container bg-surface-container-high transition-transform duration-150 scale-95" href="#">
                <span class="material-symbols-outlined">inventory_2</span> Products
            </a>
            <a class="flex items-center gap-md p-md rounded-lg text-on-surface-variant dark:text-outline font-body-base hover:bg-surface-container-high transition-colors duration-200" href="#">
                <span class="material-symbols-outlined">shopping_cart</span> Orders
            </a>
            <a class="flex items-center gap-md p-md rounded-lg text-on-surface-variant dark:text-outline font-body-base hover:bg-surface-container-high transition-colors duration-200" href="#">
                <span class="material-symbols-outlined">groups</span> Customers
            </a>
            <a class="flex items-center gap-md p-md rounded-lg text-on-surface-variant dark:text-outline font-body-base hover:bg-surface-container-high transition-colors duration-200" href="#">
                <span class="material-symbols-outlined">query_stats</span> Statistics
            </a>
        </nav>
        <div class="mt-auto pt-md border-t border-outline-variant">
            <button class="w-full flex items-center gap-md p-md rounded-lg text-on-surface-variant hover:bg-surface-container-high transition-colors">
                <span class="material-symbols-outlined">logout</span> Logout
            </button>
        </div>
    </aside>
    <!-- TopNavBar Anchor -->
    <header class="fixed top-0 right-0 w-[calc(100%-256px)] h-16 bg-surface/90 dark:bg-surface-container/90 backdrop-blur-md shadow-[0px_8px_24px_rgba(0,0,0,0.1)] z-30 flex justify-between items-center px-lg">
        <h1 class="font-headline-md text-headline-md font-bold text-primary dark:text-primary-fixed">Thêm sản phẩm</h1>
        <div class="flex items-center gap-lg">
            <div class="relative hidden lg:block">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-primary">search</span>
                <input class="pl-10 pr-4 py-2 bg-surface-container-low border border-outline-variant rounded-lg w-64 text-body-sm focus:ring-0" placeholder="Tìm kiếm..." type="text" />
            </div>
            <div class="flex items-center gap-md">
                <button class="p-2 hover:bg-surface-container-high rounded-full transition-colors">
                    <span class="material-symbols-outlined text-on-surface-variant">notifications</span>
                </button>
                <button class="p-2 hover:bg-surface-container-high rounded-full transition-colors">
                    <span class="material-symbols-outlined text-on-surface-variant">settings</span>
                </button>
                <div class="h-8 w-8 rounded-full bg-primary-container overflow-hidden border-2 border-white shadow-sm cursor-pointer">
                    <img alt="Seller Profile" data-alt="A professional headshot of a confident tech entrepreneur wearing a modern charcoal suit in a high-key minimalist office environment. The lighting is soft and directional, emphasizing the bright, youthful blue color palette and modern aesthetic of the tech-savvy seller brand." src="https://lh3.googleusercontent.com/aida-public/AB6AXuCUyERIBl3HkfuzOqtJETzV6ckENFve-UIPSGrcvrO2cu9kRpOgKgUnOW2egXeKzwPabxQfp02Do4OfyS4Kh-hnJ-6TshTcTmrGwZ7jcVajg3hOj1XoF1du2pZvyyfOz7SZq2Q98GBZ0AvzFm7jUJSaMK4G88ZrDrjKGtxCOfDFq0o4z7ITNFowzdltrzkKfrqk9I7M4EKpymTRAvv0lpDnQxTXO2ksMQ182jCkT83Z0_h8EtxZhKcdOefXrzVa_96ioEqHkptOwI5U" />
                </div>
            </div>
        </div>
    </header>
    <!-- Main Content -->
    <main class="ml-64 mt-16 p-lg bg-background min-h-screen">
        @using (Html.BeginForm("Create", "Product", FormMethod.Post, new { @class = "max-w-[1200px] mx-auto grid grid-cols-1 lg:grid-cols-3 gap-lg" }))
        {
            <!-- Left Column: Primary Information -->
            <div class="lg:col-span-2 space-y-lg">
                <!-- Section 1: Thông tin sản phẩm -->
                <section class="bg-surface-container-lowest p-lg rounded-xl custom-shadow">
                    <div class="flex items-center gap-sm mb-lg">
                        <span class="material-symbols-outlined text-primary">description</span>
                        <h2 class="font-headline-md text-headline-md">Thông tin sản phẩm</h2>
                    </div>
                    <div class="space-y-md">
                        <div>
                            <label class="block font-label-bold text-label-bold text-on-surface-variant mb-xs">Tên sản phẩm *</label>
                            @Html.TextBoxFor(m = &gt; m.Name, new { @class = "w-full p-md bg-white border border-outline-variant rounded-lg font-body-base", placeholder = "Ví dụ: Áo thun Oversize Cotton" })
                            @Html.ValidationMessageFor(m = &gt; m.Name, "", new { @class = "text-error font-body-sm text-body-sm mt-xs" })
                        </div>
                        <div class="grid grid-cols-2 gap-md">
                            <div>
                                <label class="block font-label-bold text-label-bold text-on-surface-variant mb-xs">Thương hiệu</label>
                                @Html.DropDownListFor(m = &gt; m.BrandId, new SelectList(new[] { "Nike", "Adidas", "Uniqlo", "Coolmate" }), "Chọn thương hiệu", new { @class = "w-full p-md bg-white border border-outline-variant rounded-lg font-body-base" })
                            </div>
                            <div>
                                <label class="block font-label-bold text-label-bold text-on-surface-variant mb-xs">Danh mục *</label>
                                <select class="w-full p-md bg-white border border-outline-variant rounded-lg font-body-base">
                                    <option>Áo &gt; Áo thun</option>
                                    <option>Áo &gt; Áo sơ mi</option>
                                    <option>Quần &gt; Quần Jean</option>
                                    <option>Phụ kiện &gt; Túi xách</option>
                                </select>
                            </div>
                        </div>
                        <div>
                            <label class="block font-label-bold text-label-bold text-on-surface-variant mb-xs">Mô tả sản phẩm</label>
                            @Html.TextAreaFor(m = &gt; m.Description, new { @class = "w-full p-md bg-white border border-outline-variant rounded-lg font-body-base min-h-[200px]", placeholder = "Mô tả chi tiết về sản phẩm của bạn..." })
                        </div>
                    </div>
                </section>
                <!-- Section 3: Biến thể sản phẩm -->
                <section class="bg-surface-container-lowest p-lg rounded-xl custom-shadow">
                    <div class="flex justify-between items-center mb-lg">
                        <div class="flex items-center gap-sm">
                            <span class="material-symbols-outlined text-primary">layers</span>
                            <h2 class="font-headline-md text-headline-md">Biến thể sản phẩm</h2>
                        </div>
                        <button class="flex items-center gap-xs text-primary font-label-bold text-label-bold hover:underline" type="button">
                            <span class="material-symbols-outlined text-[18px]">add</span> Thêm biến thể
                        </button>
                    </div>
                    <div class="overflow-x-auto">

                        @* @foreach (var variant in Model.Variants) { ... } *@
                        <table class="w-full border-collapse">
                            <thead class="bg-surface-container-low text-left">
                                <tr>
                                    <th class="p-md font-label-bold text-label-bold text-on-surface-variant">Kích cỡ</th>
                                    <th class="p-md font-label-bold text-label-bold text-on-surface-variant">Màu sắc</th>
                                    <th class="p-md font-label-bold text-label-bold text-on-surface-variant">Giá bán</th>
                                    <th class="p-md font-label-bold text-label-bold text-on-surface-variant">Kho hàng</th>
                                    <th class="p-md font-label-bold text-label-bold text-on-surface-variant">Ảnh</th>
                                    <th class="p-md w-12"></th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-outline-variant">
                                <!-- Sample Variant Row -->
                                <tr>
                                    <td class="p-md">
                                        <input class="w-full p-xs border border-outline-variant rounded bg-white text-body-sm" type="text" value="XL" />
                                    </td>
                                    <td class="p-md">
                                        <input class="w-full p-xs border border-outline-variant rounded bg-white text-body-sm" type="text" value="Xanh Vibrant" />
                                    </td>
                                    <td class="p-md">
                                        <input class="w-full p-xs border border-outline-variant rounded bg-white text-body-sm" type="number" value="250000" />
                                    </td>
                                    <td class="p-md">
                                        <input class="w-full p-xs border border-outline-variant rounded bg-white text-body-sm" type="number" value="100" />
                                    </td>
                                    <td class="p-md">
                                        <div class="w-10 h-10 rounded border border-dashed border-outline-variant flex items-center justify-center cursor-pointer hover:bg-surface-container-low">
                                            <span class="material-symbols-outlined text-[16px]">add_a_photo</span>
                                        </div>
                                    </td>
                                    <td class="p-md">
                                        <button class="text-error hover:bg-error-container p-1 rounded transition-colors" type="button">
                                            <span class="material-symbols-outlined text-[18px]">delete</span>
                                        </button>
                                    </td>
                                </tr>
                                <!-- Dynamic Row Logic Container -->
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>
            <!-- Right Column: Media & Status -->
            <div class="space-y-lg">
                <!-- Section 2: Ảnh sản phẩm -->
                <section class="bg-surface-container-lowest p-lg rounded-xl custom-shadow">
                    <div class="flex items-center gap-sm mb-lg">
                        <span class="material-symbols-outlined text-primary">image</span>
                        <h2 class="font-headline-md text-headline-md">Ảnh sản phẩm</h2>
                    </div>
                    <div class="grid grid-cols-2 gap-md mb-md">
                        <!-- Preview Cards -->
                        <div class="group relative aspect-square bg-surface-container-low rounded-lg overflow-hidden border border-outline-variant">
                            <img class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-110" data-alt="A studio shot of a premium cotton t-shirt displayed on a minimalist white mannequin. The lighting is high-key and soft, highlighting the texture of the vibrant blue fabric against a clean, off-white background in a professional e-commerce style." src="https://lh3.googleusercontent.com/aida-public/AB6AXuBh3qEoOi1Vkm_oswOkjiq0GFG4tlqUiguWVvUKpDRr7FynTMqsU1OS42taz2WJ4PFqLx5lG9Ffyy5I5Edjm8LCFXhrZAkNOql4KVNpqiAYzm7WASpxlyqiYTlugjTd21SQjn7E0zw0ZreqCAPncjfw6Va4MFiH6v17Wlx0EBf15nlQ1IvFM7NbxJPgq7SOMIxqS-jHZagq-kFPZvLRaTFLCbZhWUosSxdAlQLCWEsJSNaoXohNVx0V2uvoheNBq80p5GLaSJZZStB-" />
                            <div class="absolute top-2 right-2 flex gap-xs">
                                <button class="bg-white/90 p-1 rounded-full shadow-sm text-error hover:bg-white"><span class="material-symbols-outlined text-[16px]">delete</span></button>
                            </div>
                            <div class="absolute bottom-0 left-0 right-0 bg-black/50 p-1 text-center">
                                <span class="text-white text-[10px] font-label-bold uppercase">Ảnh bìa</span>
                            </div>
                        </div>
                        <div class="aspect-square bg-surface-container-low rounded-lg border-2 border-dashed border-primary/30 flex flex-col items-center justify-center cursor-pointer hover:bg-primary-container/10 transition-colors">
                            <span class="material-symbols-outlined text-primary text-3xl">add_photo_alternate</span>
                            <span class="text-label-bold font-label-bold text-primary mt-xs">Tải ảnh lên</span>
                        </div>
                    </div>
                    <p class="text-body-sm text-on-surface-variant">Hỗ trợ JPG, PNG. Tối đa 5 ảnh, mỗi ảnh không quá 2MB.</p>
                </section>
                <!-- Section 5: Trạng thái & Action -->
                <section class="bg-surface-container-lowest p-lg rounded-xl custom-shadow">
                    <div class="flex items-center gap-sm mb-lg">
                        <span class="material-symbols-outlined text-primary">settings_applications</span>
                        <h2 class="font-headline-md text-headline-md">Trạng thái &amp; Lưu</h2>
                    </div>
                    <div class="flex items-center justify-between p-md bg-surface-container-low rounded-lg mb-lg">
                        <span class="font-label-bold text-label-bold">Hiển thị sản phẩm</span>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input checked="" class="sr-only peer" type="checkbox" value="" />
                            <div class="w-11 h-6 bg-outline-variant peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary-container"></div>
                        </label>
                    </div>
                    <div class="space-y-md">
                        <button class="w-full bg-primary-container text-white py-lg rounded-lg font-headline-md text-headline-md hover:brightness-110 active:scale-[0.98] transition-all flex items-center justify-center gap-md" type="submit">
                            <span class="material-symbols-outlined">save</span> Lưu sản phẩm
                        </button>
                        <button class="w-full bg-white border border-outline text-on-surface py-md rounded-lg font-label-bold text-label-bold hover:bg-surface-container-high transition-colors" type="button">
                            Hủy bỏ
                        </button>
                    </div>
                </section>
                <!-- Help Card -->
                <div class="bg-primary/5 p-lg rounded-xl border border-primary/10">
                    <h3 class="font-label-bold text-label-bold text-primary mb-xs">Mẹo nhỏ:</h3>
                    <p class="text-body-sm text-on-primary-fixed-variant">Sử dụng ít nhất 3 ảnh từ nhiều góc độ khác nhau để tăng tỷ lệ chuyển đổi lên 40%.</p>
                </div>
            </div>
        }
    </main>
</body>
</html>
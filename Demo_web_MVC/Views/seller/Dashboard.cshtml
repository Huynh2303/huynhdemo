@model  Demo_web_MVC.Models.ViewModel.Dashboard.DashboardViewModel
<!DOCTYPE html>

<html class="light" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;600;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-tertiary-fixed-variant": "#6b3b00",
                        "on-secondary-container": "#616363",
                        "secondary-container": "#dfe0e0",
                        "primary": "#00658d",
                        "error-container": "#ffdad6",
                        "tertiary-fixed": "#ffdcc0",
                        "tertiary-container": "#ea8c21",
                        "on-secondary-fixed-variant": "#454747",
                        "tertiary-fixed-dim": "#ffb876",
                        "on-secondary-fixed": "#1a1c1c",
                        "outline-variant": "#bdc8d1",
                        "on-surface-variant": "#3e4850",
                        "on-primary": "#ffffff",
                        "surface-container": "#eaeef4",
                        "on-tertiary": "#ffffff",
                        "on-error-container": "#93000a",
                        "on-primary-fixed-variant": "#004c6b",
                        "on-primary-fixed": "#001e2d",
                        "on-tertiary-container": "#572f00",
                        "inverse-on-surface": "#ecf1f7",
                        "on-secondary": "#ffffff",
                        "surface-container-lowest": "#ffffff",
                        "surface-dim": "#d6dae0",
                        "surface-container-low": "#eff4fa",
                        "secondary-fixed-dim": "#c6c6c7",
                        "background": "#f5faff",
                        "secondary-fixed": "#e2e2e2",
                        "outline": "#6e7881",
                        "on-error": "#ffffff",
                        "tertiary": "#8d4f00",
                        "on-primary-container": "#003e58",
                        "on-background": "#171c20",
                        "inverse-primary": "#82cfff",
                        "surface-bright": "#f5faff",
                        "inverse-surface": "#2c3135",
                        "on-tertiary-fixed": "#2d1600",
                        "on-surface": "#171c20",
                        "surface-variant": "#dee3e8",
                        "primary-container": "#00aeef",
                        "error": "#ba1a1a",
                        "surface-container-highest": "#dee3e8",
                        "surface-container-high": "#e4e9ee",
                        "surface": "#f5faff",
                        "surface-tint": "#00658d",
                        "secondary": "#5d5f5f",
                        "primary-fixed": "#c6e7ff",
                        "primary-fixed-dim": "#82cfff"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "8px",
                        "xl": "12px",
                        "full": "9999px"
                    },
                    "spacing": {
                        "gutter": "16px",
                        "lg": "24px",
                        "sm": "8px",
                        "unit": "4px",
                        "xl": "48px",
                        "xs": "4px",
                        "md": "16px",
                        "container-max": "1200px"
                    },
                    "fontFamily": {
                        "price-lg": ["Be Vietnam Pro"],
                        "label-bold": ["Be Vietnam Pro"],
                        "body-sm": ["Be Vietnam Pro"],
                        "headline-md": ["Be Vietnam Pro"],
                        "display-lg": ["Be Vietnam Pro"],
                        "body-base": ["Be Vietnam Pro"]
                    },
                    "fontSize": {
                        "price-lg": ["24px", {"lineHeight": "1", "fontWeight": "700"}],
                        "label-bold": ["12px", {"lineHeight": "1.2", "letterSpacing": "0.02em", "fontWeight": "700"}],
                        "body-sm": ["14px", {"lineHeight": "1.5", "fontWeight": "400"}],
                        "headline-md": ["20px", {"lineHeight": "1.4", "fontWeight": "600"}],
                        "display-lg": ["32px", {"lineHeight": "1.2", "fontWeight": "700"}],
                        "body-base": ["16px", {"lineHeight": "1.5", "fontWeight": "400"}]
                    }
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
</head>

<body class="bg-background font-body-base text-on-background">
    <!-- Predicted Component: SideNavBar -->
    <aside class="fixed left-0 top-0 h-screen w-64 bg-surface dark:bg-surface-container shadow-[0px_4px_12px_rgba(0,0,0,0.05)] flex flex-col py-lg px-md h-full z-40">
        <div class="mb-xl px-sm">
            <h1 class="font-headline-md text-headline-md font-bold text-primary dark:text-primary-fixed-dim">Seller Pro</h1>
            <p class="font-body-sm text-body-sm text-on-surface-variant">Vibrant blue dashboard</p>
        </div>
        <nav class="flex-1 space-y-sm">
            <!-- Dashboard Tab (Active) -->
            <a asp-action="Dashboard" asp-controller="Seller" class="flex items-center gap-md p-md rounded-lg text-primary-container dark:text-primary-fixed-dim font-bold border-r-4 border-primary-container bg-surface-container-high transition-colors duration-200 hover:bg-surface-container-high scale-100 hover:scale-[1.02]" >
                <span class="material-symbols-outlined" data-icon="dashboard">dashboard</span>
                <span class="font-label-bold text-label-bold">Dashboard</span>
            </a>
            <!-- Products Tab -->
            <a asp-action="ProductsManager" asp-controller="Seller" class="flex items-center gap-md p-md rounded-lg text-on-surface-variant dark:text-outline font-body-base hover:bg-surface-container-high transition-colors duration-200" >
                <span class="material-symbols-outlined" data-icon="inventory_2">inventory_2</span>
                <span class="font-label-bold text-label-bold">Products</span>
            </a>
            <a asp-action="Statistics" asp-controller="Seller" class="flex items-center gap-md p-md rounded-xl text-on-surface-variant dark:text-outline font-body-base hover:bg-surface-container-high dark:hover:bg-surface-container-highest transition-colors duration-200">
                <span class="material-symbols-outlined">query_stats</span>
                <span class="font-body-base">Statistics</span>
            </a>
            
        </nav>
        <div class="mt-auto border-t border-outline-variant pt-lg">
            <a asp-action="CreateProduct"
               asp-controller="Seller"
               class="w-full mb-md bg-primary-container text-on-primary font-label-bold text-label-bold py-md px-lg rounded-lg shadow-[0px_4px_12px_rgba(0,0,0,0.1)] active:scale-95 duration-150 transition-transform flex items-center justify-center gap-sm">
                <span class="material-symbols-outlined text-[24px]">add</span>
                <span>Add New Product</span>
            </a>
            <a asp-action="Logout" asp-controller="User" class="flex items-center gap-md p-md rounded-lg text-on-surface-variant dark:text-outline font-body-base hover:bg-surface-container-high transition-colors duration-200" >
                <span class="material-symbols-outlined" data-icon="logout">logout</span>
                <span class="font-label-bold text-label-bold">Logout</span>
            </a>
            
        </div>
    </aside>
    
    <!-- Main Content Canvas -->
    <main class="ml-64 pt-24 p-lg min-h-screen">
        <partial name="_Dashboard" model="Model" />
    </main>
</body>
</html>
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const mainContent = document.getElementById('main-content') || (() => {
                    const div = document.createElement('div');
                    div.id = 'main-content';
                    div.className = 'flex-1 p-6 bg-gray-50 rounded-xl';
                    document.querySelector('aside').insertAdjacentElement('afterend', div);
                    return div;
                })();

                // Menu click fetch partial
                document.querySelectorAll('aside nav a[data-target]').forEach(item => {
                    item.addEventListener('click', e => {
                        e.preventDefault();
                        const target = item.dataset.target;
                        console.log('Clicked menu:', target);

                        let url = '';
                        switch(target){
                            case 'MyAddresses': url='/Adress/IndexPartial'; break;
                            case 'ProfileSettings': url='/User/_ProfilePartial'; break;
                            case 'OrderHistory': url='/Oder/_HistoryPartial'; break;
                            default: console.warn('Menu chưa cấu hình fetch:', target); return;
                        }

                        fetch(url)
                            .then(r => { console.log('Response status:', r.status); return r.text(); })
                            .then(html => { console.log('Partial loaded:', target); mainContent.innerHTML = html; })
                            .catch(err => { console.error(err); mainContent.innerHTML = '<p class="text-red-500">Không tải được nội dung.</p>'; });
                    });
                });

                // Click button fetch partial (Create/Edit)
                document.addEventListener('click', async e => {
                    const btn = e.target.closest('[data-url]');
                    if(!btn) return;
                    e.preventDefault();

                    const url = btn.dataset.url;
                    console.log('Load partial:', url);

                    try {
                        const response = await fetch(url, { method: 'GET' });
                        console.log('Response status:', response.status);
                        const html = await response.text();
                        console.log('Response body:', html);
                        if(!response.ok) throw new Error('Fetch failed: ' + response.status);
                        mainContent.innerHTML = html;
                    } catch(err) {
                        console.error('Fetch error:', err);
                        mainContent.innerHTML = '<p class="text-red-500">Không tải được dữ liệu.</p>';
                    }
                });

                // Submit form (Create/Edit/Delete)
                document.addEventListener('submit', async e => {
                    const form = e.target;
                    if(!form.action.includes('/Adress/Create') && !form.action.includes('/Adress/Edit') && !form.action.includes('/Adress/Delete') && !form.action.includes('/Adress/SetDefault')  && !form.dataset.ajax) return;
                    e.preventDefault();

                    try {
                        const formData = new FormData(form);
                        const response = await fetch(form.action, { method: form.method || 'POST', body: formData });
                        console.log('Form submit response status:', response.status);
                        const html = await response.text();
                        console.log('Form submit response body:', html);
                        if(!response.ok) throw new Error('Submit failed: ' + response.status);
                        mainContent.innerHTML = html;
                    } catch(err) {
                        console.error('Form submit error:', err);
                        mainContent.innerHTML = '<p class="text-red-500">Lỗi xảy ra khi submit</p>';
                    }
                });
            });
        </script>
        <div id="main-content"></div>

        

<!DOCTYPE html>

<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;600;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface-container": "#eaeef4",
                        "on-primary-fixed": "#001e2d",
                        "inverse-on-surface": "#ecf1f7",
                        "on-tertiary-container": "#572f00",
                        "error-container": "#ffdad6",
                        "on-secondary-container": "#616363",
                        "surface-variant": "#dee3e8",
                        "on-secondary-fixed": "#1a1c1c",
                        "on-surface-variant": "#3e4850",
                        "secondary-fixed": "#e2e2e2",
                        "on-tertiary-fixed": "#2d1600",
                        "on-tertiary": "#ffffff",
                        "background": "#f5faff",
                        "on-error-container": "#93000a",
                        "primary-fixed": "#c6e7ff",
                        "outline": "#6e7881",
                        "on-tertiary-fixed-variant": "#6b3b00",
                        "surface-container-low": "#eff4fa",
                        "surface-container-lowest": "#ffffff",
                        "on-primary": "#ffffff",
                        "on-error": "#ffffff",
                        "surface-tint": "#00658d",
                        "secondary-fixed-dim": "#c6c6c7",
                        "surface": "#f5faff",
                        "secondary-container": "#dfe0e0",
                        "secondary": "#5d5f5f",
                        "inverse-primary": "#82cfff",
                        "on-background": "#171c20",
                        "tertiary-fixed-dim": "#ffb876",
                        "tertiary-fixed": "#ffdcc0",
                        "tertiary": "#8d4f00",
                        "inverse-surface": "#2c3135",
                        "on-primary-container": "#003e58",
                        "primary": "#00658d",
                        "surface-container-high": "#e4e9ee",
                        "surface-bright": "#f5faff",
                        "on-secondary-fixed-variant": "#454747",
                        "surface-container-highest": "#dee3e8",
                        "primary-fixed-dim": "#82cfff",
                        "outline-variant": "#bdc8d1",
                        "error": "#ba1a1a",
                        "on-secondary": "#ffffff",
                        "on-surface": "#171c20",
                        "tertiary-container": "#ea8c21",
                        "surface-dim": "#d6dae0",
                        "primary-container": "#00aeef",
                        "on-primary-fixed-variant": "#004c6b"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "xl": "48px",
                        "sm": "8px",
                        "gutter": "16px",
                        "unit": "4px",
                        "lg": "24px",
                        "xs": "4px",
                        "md": "16px",
                        "container-max": "1200px"
                    },
                    "fontFamily": {
                        "price-lg": ["Be Vietnam Pro"],
                        "label-bold": ["Be Vietnam Pro"],
                        "headline-md": ["Be Vietnam Pro"],
                        "body-base": ["Be Vietnam Pro"],
                        "display-lg": ["Be Vietnam Pro"],
                        "body-sm": ["Be Vietnam Pro"]
                    },
                    "fontSize": {
                        "price-lg": ["24px", {"lineHeight": "1", "fontWeight": "700"}],
                        "label-bold": ["12px", {"lineHeight": "1.2", "letterSpacing": "0.02em", "fontWeight": "700"}],
                        "headline-md": ["20px", {"lineHeight": "1.4", "fontWeight": "600"}],
                        "body-base": ["16px", {"lineHeight": "1.5", "fontWeight": "400"}],
                        "display-lg": ["32px", {"lineHeight": "1.2", "fontWeight": "700"}],
                        "body-sm": ["14px", {"lineHeight": "1.5", "fontWeight": "400"}]
                    }

                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .active-tab {
            border-bottom: 2px solid #00aeef;
            color: #00658d;
        }

    </style>
</head>
@model List<Demo_web_MVC.Models.ViewModel.Oder.OderViewModel>
<body class="bg-background font-body-base text-on-surface">

    <main class="max-w-[1200px] mx-auto px-lg py-xl">
        @{
            ViewData["Title"] = "Danh sách đơn hàng";
        }
        <!-- Filter Tabs -->
        <div class="bg-surface-container-lowest rounded-lg shadow-sm mb-lg overflow-x-auto">
            <div class="flex min-w-max">
                <a href="@Url.Action("Index", "Oder", new { status = "All" })" class="flex-1 px-lg py-md text-label-bold font-label-bold  transition-all">Tất cả</a>
                <a href="@Url.Action("Index", "Oder", new { status = "Pending" })" class="flex-1 px-lg py-md text-label-bold font-label-bold text-on-surface-variant  hover:text-primary transition-all">Chờ xử lý</a>
                <a href="@Url.Action("Index", "Oder", new { status = "Shipping" })" class="flex-1 px-lg py-md text-label-bold font-label-bold text-on-surface-variant hover:text-primary transition-all">Đang giao</a>
                <a href="@Url.Action("Index", "Oder", new { status = "Completed" })" class="flex-1 px-lg py-md text-label-bold font-label-bold text-on-surface-variant hover:text-primary transition-all">Đã giao</a>
                <a href="@Url.Action("Index", "Oder", new { status = "Cancelled" })" class="flex-1 px-lg py-md text-label-bold font-label-bold text-on-surface-variant hover:text-primary transition-all">Đã hủy</a>
            </div>
        </div>
        <!-- Order List -->
        <div class="space-y-md">



            <partial name="_OrderList" model="Model" />
        </div>
    </main>

</body>
</html>
@model List<Demo_web_MVC.Models.ViewModel.Oder.OderViewModel>
@foreach (var order in Model)
{
    <div class="bg-surface-container-lowest rounded-lg shadow-[0px_4px_12px_rgba(0,0,0,0.05)] border border-outline-variant/30 overflow-hidden hover:shadow-[0px_8px_24px_rgba(0,0,0,0.1)] transition-all group">
        <!-- Header -->
        <div class="px-lg py-md border-b border-outline-variant/20 flex flex-wrap justify-between items-center gap-md">
            <div class="flex items-center space-x-md">
                <span class="font-label-bold text-label-bold text-on-surface-variant uppercase">Mã đơn hàng: <span class="text-primary">@order.Id</span></span>
                <span class="text-outline-variant">|</span>
                <span class="text-body-sm font-body-sm text-on-surface-variant">Ngày đặt: @order.CreateAt</span>
            </div>
            <div class="px-md py-xs rounded-full text-label-bold font-label-bold
                            @(order.Status == OrderStatus.Completed ? "bg-green-100 text-green-700" :
                                                  (order.Status == OrderStatus.Shipping ? "bg-primary-container text-primary" :
                                                  (order.Status == OrderStatus.Pending ? "bg-error-container text-error" :
                                                  (order.Status == OrderStatus.Cancelled ? "bg-tertiary-container text-tertiary" : ""))))">
            @order.Status.ToString()
        </div>
    </div>
    <!-- Items Summary -->
    <div class="p-lg space-y-md">
        @foreach (var item in order.Items)
            {
                <div class="flex items-center space-x-md">
                    <div class="w-16 h-16 rounded-lg overflow-hidden border border-outline-variant/30 shrink-0">
                        <img alt="@item.Name" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" data-alt="A clean, high-resolution product studio shot of a modern tech accessory. The lighting is soft and professional, highlighting the product textures against a neutral grey background. The visual style is minimalist and consistent with high-end e-commerce photography, using the vibrant blue accents from the brand palette where applicable." src="@item.Img" />
                    </div>
                    <div class="flex-1 min-w-0">
                        <h4 class="font-label-bold text-body-base text-on-surface truncate">@item.Name</h4>
                        <div class="text-body-sm font-body-sm text-on-surface-variant">Số lượng: @item.Quantity</div>
                    </div>
                    <div class="text-right">
                        <span class="font-label-bold text-body-base text-primary">@item.Price</span>
                    </div>
                </div>
            }


        </div>
        <!-- Footer Actions -->
        <div class="px-lg py-md bg-surface-container-low/50 flex flex-wrap justify-between items-center gap-md">
            <div class="flex items-baseline space-x-xs">
                <span class="text-body-sm font-body-sm text-on-surface-variant">Tổng tiền:</span>
                <span class="text-price-lg font-price-lg text-primary">@order.TotalAmount</span>
            </div>
            <div class="flex space-x-md">
                @if (order.Status == OrderStatus.Cancelled || order.Status == OrderStatus.Completed)
                {
                    <button class="px-lg py-sm border border-primary text-primary rounded-lg font-label-bold text-label-bold hover:bg-primary-container/10 transition-all active:scale-95">Mua lại</button>
                }
                else
                {
                    <form asp-action="CancelOrder" asp-controller="Oder" asp-route-orderId="@order.Id" method="post">
                        <input type="hidden" name="orderId" value="@order.Id" /> <!-- Lưu trữ thông tin orderId trong một trường ẩn -->
                        <button class="px-lg py-sm border border-outline text-secondary rounded-lg font-label-bold text-label-bold hover:bg-surface-variant transition-all active:scale-95" type="submit">
                            Hủy đơn
                        </button>
                    </form>
                }
                <a asp-action="Details" asp-controller="Oder" asp-route-orderId="@order.Id" class="px-lg py-sm bg-primary-container text-on-primary-container rounded-lg font-label-bold text-label-bold hover:opacity-90 transition-all active:scale-95 shadow-sm">Xem chi tiết</a>
            </div>
        </div>
    </div>

}